  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp1", "top": 0, "left": -180, "attrs": {} },
    { "type": "board-esp32-devkit-c-v4", "id": "esp2", "top": 0, "left": 180, "attrs": {} }
  ],
  "connections": [
    [ "esp1:TX", "$serialMonitor:RX", "green", [] ],
